FROM node:24-alpine

# Utilitários de sistema para healthchecks e scripts
RUN apk add --no-cache curl bash

WORKDIR /app

# Maximiza o reaproveitamento de cache copiando apenas manifestos primeiro
COPY package.json package-lock.json ./

# Instala todas as dependências do monorepo Nx e remove o cache transitório
RUN npm ci --prefer-offline --no-audit && \
    npm cache clean --force && \
    rm -rf /root/.npm

# Script de entrypoint com conversao de quebras de linha para compatibilidade Windows (CRLF -> LF)
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN dos2unix /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
