# Porta da API NestJS
PORT=3000

# Configurações do Firebase (Valores locais para os emuladores)
FIREBASE_PROJECT_ID=demo-alcadas
FIREBASE_API_KEY=dummy_api_key_for_local_dev

# --- Somente produção (NUNCA commitar valores reais; configurar no painel do Render) ---
# Site do Firebase Hosting cujos canais de preview (https://<site>--pr12-abc.web.app) entram no CORS.
# Sem ela vale o FIREBASE_PROJECT_ID.
# FIREBASE_HOSTING_SITE=

# URLs de Integração
# Origens fixas liberadas no CORS da API (separadas por vírgula). Em produção: só o domínio oficial
# .web.app do Firebase Hosting — os canais de preview são aceitos pelo padrão do FIREBASE_HOSTING_SITE.
WEB_URL=http://localhost:4200
API_URL=http://localhost:3000

# Variáveis do Nx
NX_DAEMON=true
