# Porta da API NestJS
PORT=3000

# Configurações do Firebase (Valores locais para os emuladores)
FIREBASE_PROJECT_ID=demo-alcadas
# Chave Web do projeto (pública). Em produção a API a usa para pedir ao Firebase Auth o envio do
# e-mail de definição de senha ao colaborador recém-cadastrado.
FIREBASE_API_KEY=dummy_api_key_for_local_dev

# --- Somente produção (NUNCA commitar valores reais; configurar no painel do Render) ---
# Site do Firebase Hosting cujos canais de preview (https://<site>--pr12-abc.web.app) entram no CORS.
# Sem ela vale o FIREBASE_PROJECT_ID.
# FIREBASE_HOSTING_SITE=
# Conta de serviço do Firebase Admin SDK: JSON puro ou o mesmo JSON em base64.
# Sem ela o Admin SDK usa GOOGLE_APPLICATION_CREDENTIALS / credenciais padrão do ambiente.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Por quanto tempo (ms) um /api/readyz saudável é reaproveitado antes de ler o Firestore de novo.
# READYZ_CACHE_TTL_MS=60000

# --- Seed mínimo de produção (npm run seed:prod) — senhas provisórias, fora do Git ---
# SEED_CONFIRMAR=producao
# SEED_SENHA_SOLICITANTE=
# SEED_SENHA_GERENTE=
# SEED_SENHA_DIRETOR=
# SEED_SENHA_CFO=
# SEED_DOMINIO_EMAIL=startop.com.br

# URLs de Integração
# Origens fixas liberadas no CORS da API (separadas por vírgula). Em produção: só o domínio oficial
# .web.app do Firebase Hosting — os canais de preview são aceitos pelo padrão do FIREBASE_HOSTING_SITE.
WEB_URL=http://localhost:4200
API_URL=http://localhost:3000

# Variáveis do Nx
NX_DAEMON=true
