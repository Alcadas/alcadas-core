# Porta da API NestJS
PORT=3000

# Configurações do Firebase (Valores locais para os emuladores)
FIREBASE_PROJECT_ID=demo-alcadas
FIREBASE_API_KEY=dummy_api_key_for_local_dev

# URLs de Integração
# Origens liberadas no CORS da API (separadas por vírgula). Em produção: o domínio .web.app do Firebase Hosting.
WEB_URL=http://localhost:4200
API_URL=http://localhost:3000

# Variáveis do Nx
NX_DAEMON=true
